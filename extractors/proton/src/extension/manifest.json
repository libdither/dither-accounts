{
  "manifest_version": 3,
  "name": "Proton bridge",
  "version": "0.1.1",
  "description": "Lets a local extractor call Proton Mail's API as the signed-in Mail page does. Personal use.",
  "minimum_chrome_version": "111",
  "background": { "service_worker": "sw.js" },
  "permissions": ["tabs", "alarms"],
  "host_permissions": ["https://mail.proton.me/*"],
  "content_scripts": [
    {
      "matches": ["https://mail.proton.me/*"],
      "js": ["hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://mail.proton.me/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ]
}
