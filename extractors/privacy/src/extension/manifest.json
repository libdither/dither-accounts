{
  "manifest_version": 3,
  "name": "Privacy passkey",
  "version": "0.3.0",
  "description": "A passkey for privacy.com held by a local extractor: answers the page's navigator.credentials calls on privacy.com only. Personal use.",
  "minimum_chrome_version": "111",
  "background": { "service_worker": "sw.js" },
  "permissions": ["tabs", "alarms"],
  "host_permissions": ["https://privacy.com/*", "https://*.privacy.com/*"],
  "content_scripts": [
    {
      "matches": ["https://privacy.com/*", "https://*.privacy.com/*"],
      "js": ["hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://privacy.com/*", "https://*.privacy.com/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ]
}
