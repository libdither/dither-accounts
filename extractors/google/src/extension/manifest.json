{
  "manifest_version": 3,
  "name": "Google bridge",
  "version": "0.2.0",
  "description": "Lets a local extractor call Google Calendar and Gmail as their signed-in pages do. Personal use.",
  "minimum_chrome_version": "111",
  "background": { "service_worker": "sw.js" },
  "permissions": ["tabs", "alarms"],
  "host_permissions": ["https://calendar.google.com/*", "https://mail.google.com/*"],
  "content_scripts": [
    {
      "matches": ["https://calendar.google.com/*", "https://mail.google.com/*"],
      "js": ["hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://calendar.google.com/*", "https://mail.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ]
}
