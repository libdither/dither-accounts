{
  "manifest_version": 3,
  "name": "Substack bridge",
  "version": "0.1.0",
  "description": "Relays a signed-in substack.com reader's inbox, notes and activity to a local extractor, and runs its commands with the reader's own calls. Personal use.",
  "minimum_chrome_version": "111",
  "background": { "service_worker": "sw.js" },
  "permissions": ["tabs", "alarms"],
  "host_permissions": ["https://substack.com/*"],
  "content_scripts": [
    {
      "matches": ["https://substack.com/*"],
      "js": ["hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://substack.com/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ]
}
