<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: a wake-up or a push endpoint from adb, to try the link without a distributor. Never in a release. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <receiver
            android:name=".DebugPushReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="org.libdither.approver.DEBUG_PUSH" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
