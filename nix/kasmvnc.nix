# kasmvnc from https://github.com/zyansheep/KasmVNC at v1.5.2-dither.4: upstream's v1.5.2 with this fork's
# commits on top (https://github.com/zyansheep/KasmVNC/compare/v1.5.2...v1.5.2-dither.4).
# Generated by contrib/dither/consumer.sh for the release; built and smoke-tested by the fork's CI against nixpkgs
# 34ab99075ac4f7e40cf037eef32cb1c360bb85e9. Copy it as it is; a new release brings a new file.
#   nix-build kasmvnc.nix
{ pkgs ? import <nixpkgs> { } }:
let
  src = pkgs.fetchFromGitHub {
    owner = "zyansheep";
    repo = "KasmVNC";
    tag = "v1.5.2-dither.4";
    hash = "sha256-MXZyqjbjYkmttipHcZnVkafC/5oSRpSLFn1x3vftZ8k=";
  };
in
pkgs.callPackage (
  # KasmVNC's X server (Xkasmvnc: its Xvnc, renamed as the .deb names it) and kasmvncpasswd, built from source the way
  # builder/build.sh builds it in Docker, but against nixpkgs' libraries and nixpkgs' X server sources (as nixpkgs'
  # tigervnc builds its Xvnc).
  #
  # Left out on purpose: the web client (kasmweb, an npm build; only its websocket listener serves it, and with no
  # -websocketPort there is none) and the vncserver Perl wrapper. FFmpeg's libraries are found at run time by soname
  # (common/rfb/ffmpeg.cxx); none are on this package's library path unless withFFmpeg is set, so its video encoders
  # stay off as they did in the .deb on NixOS.
  #
  # A plain callPackage function with no relative imports, so consumer.sh can inline it into the self-contained
  # kasmvnc.nix attached to each release.
  {
    lib,
    stdenv,
    src,
    version,
    withFFmpeg ? false,
    cmake,
    pkg-config,
    autoconf,
    automake,
    libtool,
    util-macros,
    font-util,
    perl,
    xorg-server,
    xorgproto,
    xkbcomp,
    xkeyboard_config,
    font-misc-misc,
    zlib,
    libpng,
    libjpeg_turbo,
    freetype,
    libwebp,
    openssl,
    libcpuid,
    fmt,
    onetbb,
    libyuv,
    libva,
    libdrm,
    libgbm,
    ffmpeg_7-headless,
    pam,
    libxcrypt,
    libx11,
    libxext,
    libxtst,
    libxi,
    libxrandr,
    libxdamage,
    libxfixes,
    libxcursor,
    libxkbfile,
    libxfont_2,
    libxau,
    libxdmcp,
    libxshmfence,
    pixman,
    libbsd,
    libunwind,
    libGL,
  }:
  stdenv.mkDerivation {
    pname = "kasmvnc";
    inherit version src;

    nativeBuildInputs = [
      cmake
      pkg-config
      autoconf
      automake
      libtool
      util-macros
      font-util
      perl
    ]
    ++ xorg-server.nativeBuildInputs;

    buildInputs = [
      xorgproto
      zlib
      libpng
      # KasmVNC links libturbojpeg statically (CMakeLists.txt: -Wl,-Bstatic -lturbojpeg), as its own packages do.
      (libjpeg_turbo.override { enableStatic = true; })
      freetype
      libwebp
      openssl
      libcpuid
      fmt
      onetbb
      libyuv
      libva
      libdrm
      libgbm
      # Headers only: the libraries are opened at run time (see above). 7.x is the series upstream's packages build with.
      ffmpeg_7-headless
      pam
      libxcrypt
      libx11
      libxext
      libxtst
      libxi
      libxrandr
      libxdamage
      libxfixes
      libxcursor
      libxkbfile
      libxfont_2
      libxau
      libxdmcp
      libxshmfence
      pixman
      libbsd
      libunwind
      libGL
    ]
    ++ xorg-server.buildInputs;

    # KasmVNC's X server build expects the CMake build in the source tree (KASMVNC_BUILDDIR=KASMVNC_SRCDIR).
    dontUseCmakeBuildDir = true;
    cmakeFlags = [
      (lib.cmakeFeature "CMAKE_BUILD_TYPE" "RelWithDebInfo")
      (lib.cmakeBool "BUILD_VIEWER" false)
      (lib.cmakeBool "ENABLE_GNUTLS" false)
      # Its CMakeLists.txt still says 2.8, which CMake 4 refuses without this.
      (lib.cmakeFeature "CMAKE_POLICY_VERSION_MINIMUM" "3.5")
    ];

    env.NIX_CFLAGS_COMPILE = "-Wno-error=array-bounds";

    # The X server: nixpkgs' sources with KasmVNC's patch for 21.x, configured as builder/build.sh does, but with the
    # keyboard compiler, keyboard maps and fonts at nixpkgs' paths instead of /usr's.
    postBuild = ''
      tar -xf ${xorg-server.src} -C unix/xserver --strip-components=1
      pushd unix/xserver
      patch -Np1 -i ../xserver21.patch
      autoreconf -fi
      ./configure \
        --disable-config-hal --disable-config-udev --disable-dmx --disable-dri --disable-dri2 --disable-kdrive \
        --disable-static --disable-xephyr --disable-xinerama --disable-xnest --disable-xorg --disable-xvfb \
        --disable-xwayland --disable-xwin --disable-devel-docs --disable-docs --disable-unit-tests \
        --enable-glx --without-dtrace --with-sha1=libcrypto \
        --prefix="$out" \
        --with-default-font-path="${font-misc-misc}/share/fonts/X11/misc,built-ins" \
        --with-xkb-bin-directory="${xkbcomp}/bin" \
        --with-xkb-path="${xkeyboard_config}/share/X11/xkb" \
        --with-xkb-output=/tmp
      find . -name Makefile -exec sed -i 's/-Werror=array-bounds//g' {} +
      make -j"$NIX_BUILD_CORES"
      popd
    '';

    installPhase = ''
      runHook preInstall
      install -Dm755 unix/xserver/hw/vnc/Xvnc "$out/bin/Xkasmvnc"
      install -Dm755 unix/kasmvncpasswd/kasmvncpasswd "$out/bin/kasmvncpasswd"
      runHook postInstall
    '';

    postFixup = lib.optionalString withFFmpeg ''
      patchelf --add-rpath "${lib.getLib ffmpeg_7-headless}/lib:${lib.getLib libva}/lib" "$out/bin/Xkasmvnc"
    '';

    meta = {
      description = "KasmVNC's X server with a VNC server built in, with a faster FFmpeg lookup";
      homepage = "https://github.com/zyansheep/KasmVNC/tree/dither";
      license = lib.licenses.gpl2Plus;
      platforms = lib.platforms.linux;
      mainProgram = "Xkasmvnc";
    };
  }
) {
  inherit src;
  version = "1.5.2-dither.4";
}
